ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Models (default claude-haiku-5-5, cheap, for development). For official eval numbers:
# AGENT_MODEL=claude-opus-5-5
# JUDGE_MODEL=claude-sonnet-5-5
# GEN_MODEL=claude-sonnet-5-5
# ROUTER_MODEL=claude-haiku-5-5   (picks the specialist; Haiku is enough)
# The public demo runs AGENT_MODEL=claude-sonnet-5-5 with the Haiku router.

# Online safety (leave empty locally)
# The web server must send AGENT_API_SECRET in X-Agent-Secret; set the same value in web/.env.local.
AGENT_API_SECRET=
# New messages are refused once today's Claude spend reaches this many dollars (0 = no cap).
DAILY_SPEND_CAP_USD=5
